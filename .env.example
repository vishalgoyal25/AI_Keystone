# AI_Keystone — environment variable template.
#
# Copy to `.env` (gitignored) and fill with real values. NEVER commit real secrets.
# Tracked files reference variable NAMES only. Placeholders below are obviously fake.
# Variables are added to this file as each phase introduces them.

# ---------- Local datastores (Phase 2) ----------
DATABASE_URL=postgresql://keystone:password@localhost:5432/keystone
REDIS_URL=redis://localhost:6379/0

# ---------- Object storage — L3 memory tier (Phase 5) ----------
# MinIO locally; the same variables point at S3 in cloud (one code path).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=<YOUR_MINIO_ACCESS_KEY>
S3_SECRET_KEY=<YOUR_MINIO_SECRET_KEY>
S3_BUCKET=keystone-local

# ---------- Model providers (Phase 2 / 7) ----------
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_KEY>
GROQ_API_KEY=<YOUR_GROQ_KEY>
CEREBRAS_API_KEY=<YOUR_CEREBRAS_KEY>

# ---------- Observability (Phase 11) ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_PUBLIC_KEY=<YOUR_LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<YOUR_LANGFUSE_SECRET_KEY>

# ---------- AWS (Phase 16 — prefer OIDC over static keys in CI) ----------
AWS_REGION=us-east-1
# Local dev only; CI authenticates via OIDC role assumption (see ADR, Phase 16).

# ---------- App ----------
ENVIRONMENT=development   # development | staging | production
LOG_LEVEL=INFO
