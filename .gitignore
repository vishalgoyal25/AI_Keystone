# ---------------------------------------------------------------------------
# AI_Keystone — .gitignore
#
# Convention: a leading "/" anchors a rule to the repo root. Unanchored names
# match at EVERY depth and can silently swallow source directories — e.g. bare
# "models/" would also ignore src/keystone/infrastructure/models/. Anchor
# anything whose name could plausibly appear inside src/.
# ---------------------------------------------------------------------------

# ===== Environments =========================================================
myvenv/
.venv/
venv/
env/
ENV/
.conda/
conda-meta/
envs/
*.conda

# ===== Python ===============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
/build/
/dist/
/sdist/
/wheels/
develop-eggs/
.eggs/
*.egg-info/
*.egg
.installed.cfg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# ===== Testing / coverage / typing / lint ===================================
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
nosetests.xml
junit.xml
/test-results/

