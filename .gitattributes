# AI_Keystone — line-ending and diff behaviour.
#
# Development happens on Windows; CI and production run on Linux. Without this file,
# Windows checkouts introduce CRLF, which shows up as whole-file diffs, breaks shell
# scripts inside containers, and fights the pre-commit mixed-line-ending hook.
#
# Rule: LF in the repository, always. Git normalises on commit.

# Default: treat as text, store LF in the repo
* text=auto eol=lf

# --- Source ---------------------------------------------------------------
*.py      text eol=lf diff=python
*.pyi     text eol=lf diff=python
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.sql     text eol=lf
*.sh      text eol=lf
*.tf      text eol=lf
*.hcl     text eol=lf

# --- Config & docs --------------------------------------------------------
*.md      text eol=lf diff=markdown
*.toml    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
.env.example text eol=lf
Makefile  text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Windows-only scripts keep CRLF — PowerShell and cmd expect it
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# --- Binary: never normalise, never diff ----------------------------------
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.mp4     binary
*.webm    binary
*.woff    binary
*.woff2   binary
*.parquet binary
*.pkl     binary
*.joblib  binary
*.onnx    binary
*.safetensors binary

# --- Notebooks: keep outputs (they are evidence), but do not merge them ---
*.ipynb   text eol=lf linguist-documentation

# --- Language statistics: keep the repo's reported language honest --------
docs/**        linguist-documentation
notebooks/**   linguist-documentation
