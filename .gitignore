# ===== Evals  (datasets + results ARE tracked — they are the record) ========
/evals/**/__pycache__/
/evals/scratch/

# ===== Logs, traces, profiling ==============================================
/logs/
*.log
*.log.*
/traces/
*.trace
*.prof
*.lprof
/profile_output/

# ===== Load testing =========================================================
/tests/load/results/
