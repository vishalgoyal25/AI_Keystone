# ===== Jupyter  (outputs ARE kept — notebooks are evidence) =================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.nbconvert.ipynb
profile_default/
ipython_config.py

# ===== Sandbox scratch (Phase 4 tool isolation) =============================
/sandbox-tmp/

# ===== Editors & IDEs =======================================================
# Standard practice: track PROJECT-level config (so the repo configures itself for
# anyone who clones it), ignore PERSONAL preference (themes, fonts) — those belong
# in user settings, not the workspace.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.vscode/*.local.json
.idea/

# Claude Code: project settings may be shared; *.local.json is per-machine
.claude/settings.local.json
.claude/*.local.json
.cursor/
.aider*
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*~

# ===== OS ===================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

